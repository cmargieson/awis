{
  "name": "awis",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "upgrade:tamagui": "npm update tamagui @tamagui/config @tamagui/babel-plugin @tamagui/metro-plugin",
    "start": "npx expo start -c",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build --platform android --profile production",
    "submit:android": "eas submit --platform android --profile production --latest",
    "deploy:android": "eas build --platform android --profile production --auto-submit"
  },
  "dependencies": {
    "@tamagui/config": "^2.4.1",
    "@tamagui/core": "^2.4.1",
    "@tamagui/font-inter": "^2.4.1",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.3",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0",
    "tamagui": "^2.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@biomejs/biome": "^1.9.4",
    "@expo/metro-runtime": "~57.0.3",
    "@tamagui/babel-plugin": "^2.4.1",
    "@tamagui/metro-plugin": "^2.4.1",
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "tamagui": "$tamagui",
    "@tamagui/core": "$@tamagui/core"
  },
  "allowScripts": {
    "@biomejs/biome": true,
    "esbuild": true
  },
  "private": true
}
