# Dependencies
node_modules/

# Expo
.expo/
expo-env.d.ts
expo-*.json

# Tamagui
.tamagui/

# Environment and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
google-play-service-account.json
*service-account*.json
*service_account*.json

# Android native project (generated by prebuild) and local release artifacts.
# Keep the keystore example tracked so local Gradle builds have a template.
/android/*
!/android/keystore.properties.example
/release/
*.jks
*.keystore

# Build outputs and caches
dist/
tmp/
*.tsbuildinfo
*.tmp.js

# Type declaration source maps (keep .d.ts / .ts sources tracked)
**/types/**/*.d.ts.map

# IDE and OS
.idea/
.DS_Store

# Logs
npm-debug.log*
yarn-error.log
